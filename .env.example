# RAG 시스템 구축 따라하기 — 환경 설정 템플릿
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채웁니다.
#   cp .env.example .env

# ─────────────────────────────────────────────────────────────
# PostgreSQL (07장. docker/postgres 의 compose 로 기동)
# ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ragbook
POSTGRES_USER=raguser
POSTGRES_PASSWORD=<비밀번호>

DATABASE_URL=postgresql://raguser:<비밀번호>@localhost:5432/ragbook

PG_POOL_MIN=2
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT=10

# ─────────────────────────────────────────────────────────────
# 임베딩
# ─────────────────────────────────────────────────────────────
# 백엔드 선택: openai(OpenAI API) | server(자체 bge-m3 서버)
# 둘 다 OpenAI 규격(/v1/embeddings)이라 base_url만 다르다.
EMBED_BACKEND=server
EMBED_DIM=1024
EMBED_TIMEOUT=60

# server 백엔드 — deploy/embed_openai_server.py 로 띄운 서버 주소
EMBED_BASE_URL=http://localhost:8000
EMBED_SERVER_MODEL=bge-m3

# openai 백엔드 — text-embedding-3-small 은 1536차원이므로 EMBED_DIM도 함께 바꿀 것
# EMBED_OPENAI_MODEL=text-embedding-3-small
# OPENAI_API_KEY=<발급받은 키>

# ─────────────────────────────────────────────────────────────
# 청킹 (03-3)
# ─────────────────────────────────────────────────────────────
CHUNK_TARGET_CHARS=900
CHUNK_OVERLAP_CHARS=150
CHUNK_MAX_CHARS=1600

# ─────────────────────────────────────────────────────────────
# 검색 튜닝 (06, 08)
# ─────────────────────────────────────────────────────────────
SEARCH_TOPK_PER_MODE=30
SEARCH_TOP_N=10

RRF_K=60
RRF_WEIGHT_KEYWORD=1.0
RRF_WEIGHT_FALLBACK=0.5
RRF_WEIGHT_SEMANTIC=1.0

# 후보 제한 — 규모가 커질 때 성능을 좌우한다 (08-3)
SEARCH_KEYWORD_CANDIDATES=2000
SEARCH_FALLBACK_CANDIDATES=300

# pgvector HNSW 탐색 폭
HNSW_EF_SEARCH=80

# ─────────────────────────────────────────────────────────────
# LLM (09, 10장. 선택)
# ─────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=<발급받은 키>
# LLM_MODEL=claude-sonnet-5
